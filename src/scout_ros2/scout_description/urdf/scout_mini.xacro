<?xml version="1.0"?>
<!-- Adapted from AgileX Robotics scout_ros/scout_description/urdf/scout_mini.urdf.xacro.
     Gazebo-only and ROS 1 extras includes are omitted for this ROS 2 description. -->

<robot name="scout_mini" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:arg name="robot_namespace" default="/" />
    <xacro:include filename="$(find scout_description)/urdf/scout_mini_wheel.xacro" />

    <!-- Measured installation: axle height 0.079 m, lidar ground height 0.405 m.
         base_link is at the midpoint of the four wheel axes, at axle height.
         Lidar rotation assumes aligned axes before a forward 30-degree tilt. -->
    <xacro:arg name="publish_lidar_tf" default="true" />
    <xacro:arg name="lidar_x" default="0.130" />
    <xacro:arg name="lidar_y" default="0.0" />
    <xacro:arg name="lidar_z" default="0.326" />
    <xacro:arg name="lidar_pitch" default="0.523599" />
    <xacro:arg name="lidar_yaw" default="0.0" />

    <!-- Variables -->
    <xacro:property name="M_PI" value="3.14159"/>

    <!-- Vehicle Geometries -->
    <xacro:property name="base_x_size" value="0.6200000" />
    <xacro:property name="base_y_size" value="0.585000" />
    <xacro:property name="base_z_size" value="0.235000" />

    <xacro:property name="wheelbase" value="0.451"/>
    <xacro:property name="track" value="0.490"/>
    <xacro:property name="wheel_vertical_offset" value="0.0" />

    <xacro:property name="wheel_length" value="0.8e-01" />
    <xacro:property name="wheel_radius" value="0.079" />

    <!-- Preserve the old CAD appearance while lowering the frame to axle height.
         The legacy body mesh is illustrative, not a calibrated collision hull. -->
    <xacro:property name="body_mesh_z" value="0.100998" />
    <link name="base_footprint" />
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link" />
        <child link="base_footprint" />
        <origin xyz="0 0 -0.079" rpy="0 0 0" />
    </joint>

    <!-- Base link -->
    <link name="base_link">
        <visual>
            <origin
                    xyz="0 0 ${body_mesh_z}"
                    rpy="1.5707 0 -1.5707" />
            <geometry>
                <mesh filename="package://scout_description/meshes/scout_mini_base_link.dae" />
            </geometry>
        </visual>
        <collision>
            <origin
                    xyz="0 0 ${body_mesh_z}"
                    rpy="1.5707 0 -1.5707" />
          <geometry>
            <mesh
              filename="package://scout_description/meshes/scout_mini_base_link.dae" />
          </geometry>
        </collision>
    </link>

    <link name="inertial_link">
        <inertial>
            <mass value="60" />
            <origin xyz="0.0 0.0 0.0" />
            <inertia ixx="2.288641" ixy="0" ixz="0" iyy="5.103976" iyz="0" izz="3.431465" />
        </inertial>
    </link>

    <joint name="inertial_joint" type="fixed">
        <origin xyz="0 0 ${body_mesh_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="inertial_link" />
    </joint>

    <!-- Scout wheel macros -->
    <!-- wheel labeled from 0 to 3, conter-clockwise, starting from front right wheel -->
    <!-- motor 1 and 2 (left side) are mechanically installed in a reversed direction -->
    <xacro:scout_mini_wheel wheel_prefix="front_right">
        <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="1.57 0 0" />
    </xacro:scout_mini_wheel>
    <xacro:scout_mini_wheel wheel_prefix="front_left">
        <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="-1.57 0 0" />
    </xacro:scout_mini_wheel>
    <xacro:scout_mini_wheel wheel_prefix="rear_left">
        <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="-1.57 0 0" />
    </xacro:scout_mini_wheel>
    <xacro:scout_mini_wheel wheel_prefix="rear_right">
        <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="1.57 0 0" />
    </xacro:scout_mini_wheel>

    <link name="front_mount" />

    <joint name="front_mount_joint" type="fixed">
        <origin xyz="0.175 0 ${0.068999 + body_mesh_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="front_mount" />
    </joint>

    <link name="rear_mount" />

    <joint name="rear_mount_joint" type="fixed">
        <origin xyz="-0.175 0 ${0.068999 + body_mesh_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="rear_mount" />
    </joint>

    <!-- Same two-stage frame names as the earlier standalone lidar TF launch. -->
    <xacro:if value="$(arg publish_lidar_tf)">
        <link name="livox_level" />
        <joint name="base_to_livox_level" type="fixed">
            <parent link="base_link" />
            <child link="livox_level" />
            <origin xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)" rpy="0 0 0" />
        </joint>
        <link name="livox_frame" />
        <joint name="level_to_livox_frame" type="fixed">
            <parent link="livox_level" />
            <child link="livox_frame" />
            <origin xyz="0 0 0" rpy="0 $(arg lidar_pitch) $(arg lidar_yaw)" />
        </joint>
    </xacro:if>
</robot>
